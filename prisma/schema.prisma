datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions String[] @default([])
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  image        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Employee {
  id               String   @id @default(cuid())
  fullName         String
  email            String   @unique
  department       String   @default("")
  status           String   @default("Active")
  personalInfo     Json     @default("{}")
  officeInfo       Json     @default("{}")
  contactInfo      Json     @default("{}")
  shiftAndPunch    Json     @default("{}")
  emergencyContact Json     @default("{}")
  qualifications   Json     @default("[]")
  skills           Json     @default("[]")
  experience       Json     @default("[]")
  references       Json     @default("[]")
  documents        Json     @default("[]")
  officeActivities Json     @default("{}")
  visibleToRoles   String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
